<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sgt_erp_license_tree" model="ir.ui.view">
            <field name="name">sgt.erp.license.list</field>
            <field name="model">sgt.erp.license</field>
            <field name="arch" type="xml">
                <list string="Licenses">
                    <field name="name"/>
                    <field name="customer_name"/>
                    <field name="package_id"/>
                    <field name="expiration_date"/>
                    <field name="max_users"/>
                    <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status in ['expiring', 'trial']" decoration-danger="status in ['expired', 'suspended']"/>
                </list>
            </field>
        </record>

        <record id="view_sgt_erp_license_form" model="ir.ui.view">
            <field name="name">sgt.erp.license.form</field>
            <field name="model">sgt.erp.license</field>
            <field name="arch" type="xml">
                <form string="License Configuration">
                    <header>
                        <button name="action_verify_online_license" string="Verify License" type="object" class="btn-primary" icon="fa-check-circle"/>
                        <field name="status" widget="statusbar" statusbar_visible="trial,active,expiring,expired,suspended"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning mb-3" role="alert" invisible="not license_warning">
                            <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                            <field name="license_warning" readonly="1"/>
                        </div>
                        <div class="oe_title">
                            <label for="customer_name"/>
                            <h1><field name="customer_name" placeholder="Client or Organization Name"/></h1>
                        </div>
                        <group>
                            <group string="Subscription Details">
                                <field name="name"/>
                                <field name="package_id" options="{'no_create': True}"/>
                                <field name="company_id" options="{'no_create': True}"/>
                                <field name="max_users"/>
                                <field name="mode"/>
                            </group>
                            <group string="Validity &amp; Security">
                                <field name="start_date"/>
                                <field name="expiration_date"/>
                                <field name="license_key" password="True"/>
                                <field name="license_server_url" invisible="mode != 'online'"/>
                                <field name="last_sync_date" readonly="1" invisible="mode != 'online'"/>
                                <field name="online_status_message" readonly="1" invisible="mode != 'online'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Terms &amp; Notes" name="notes">
                                <field name="notes" placeholder="Ghi chú điều khoản hợp đồng hoặc gói phần mềm..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sgt_erp_license" model="ir.actions.act_window">
            <field name="name">Licenses</field>
            <field name="res_model">sgt.erp.license</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Quản lý thông tin thời hạn bản quyền ERP cục bộ của khách hàng.
                </p>
            </field>
        </record>
    </data>
</odoo>
