<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View for ERP Config -->
        <record id="view_sgt_erp_config_tree" model="ir.ui.view">
            <field name="name">sgt.erp.config.list</field>
            <field name="model">sgt.erp.config</field>
            <field name="arch" type="xml">
                <list string="ERP Configurations">
                    <field name="company_id"/>
                    <field name="product_name"/>
                    <field name="customer_name"/>
                    <field name="package_id"/>
                    <field name="theme_id"/>
                    <field name="environment" widget="badge"/>
                    <field name="erp_version"/>
                </list>
            </field>
        </record>

        <record id="action_sgt_erp_config" model="ir.actions.act_window">
            <field name="name">General Setup</field>
            <field name="res_model">sgt.erp.config</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo cấu hình ERP cho khách hàng / doanh nghiệp.
                </p>
            </field>
        </record>
    </data>
</odoo>
