<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!-- LIST VIEW                                                    -->
        <!-- ============================================================ -->
        <record id="view_sgt_erp_backup_tree" model="ir.ui.view">
            <field name="name">sgt.erp.backup.list</field>
            <field name="model">sgt.erp.backup</field>
            <field name="arch" type="xml">
                <list string="Backup Archives" decoration-danger="state == 'failed'" decoration-success="state == 'success'">
                    <header>
                        <button name="action_trigger_backup_now" string="Full Backup (ZIP)" type="object" class="btn btn-sm btn-primary text-nowrap" icon="fa-database" display="always"/>
                        <button name="action_trigger_backup_now" string="Quick Dump" type="object" class="btn btn-sm btn-outline-secondary text-nowrap" context="{'backup_type': 'dump'}" icon="fa-file-text-o" display="always"/>
                    </header>
                    <field name="name" string="Archive Name" class="fw-bold"/>
                    <field name="backup_date" string="Created Date"/>
                    <field name="backup_type" widget="badge" string="Format"/>
                    <field name="backup_mode" widget="badge" string="Trigger Mode"/>
                    <field name="file_size_mb" string="Size (MB)"/>
                    <field name="state" widget="badge" 
                           decoration-success="state == 'success'" 
                           decoration-warning="state == 'running'" 
                           decoration-danger="state == 'failed'" 
                           string="Status"/>
                    <field name="company_id" string="Company" optional="hide"/>
                    <button name="action_download_backup" type="object" string="Download" icon="fa-download" class="btn btn-sm btn-outline-primary" invisible="state != 'success'"/>
                    <button name="action_delete_backup" type="object" string="Delete" icon="fa-trash" class="btn btn-sm btn-link text-danger" confirm="Are you sure you want to permanently delete this backup file from disk?"/>
                </list>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- FORM VIEW                                                    -->
        <!-- ============================================================ -->
        <record id="view_sgt_erp_backup_form" model="ir.ui.view">
            <field name="name">sgt.erp.backup.form</field>
            <field name="model">sgt.erp.backup</field>
            <field name="arch" type="xml">
                <form string="Backup Archive">
                    <header>
                        <button name="action_trigger_backup_now" string="Run Backup Now" type="object" class="btn btn-success" icon="fa-play" invisible="state == 'success'"/>
                        <button name="action_download_backup" string="Download Archive" type="object" class="btn btn-primary" icon="fa-download" invisible="state != 'success'"/>
                        <button name="action_delete_backup" string="Delete Archive Permanently" type="object" class="btn btn-outline-danger" icon="fa-trash" confirm="This action will permanently delete the physical backup file from the server. Are you sure?" invisible="not id"/>
                        <field name="state" widget="statusbar" statusbar_visible="running,success,failed"/>
                    </header>
                    <sheet>
                        <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                            <h4 class="alert-heading fw-bold"><i class="fa fa-exclamation-triangle me-2" title="Alert"/>Backup process failed!</h4>
                            <field name="error_log"/>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Backup Archive Name"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Backup Parameters">
                                <field name="backup_date"/>
                                <field name="db_name"/>
                                <field name="backup_type"/>
                                <field name="backup_mode"/>
                            </group>
                            <group string="Physical Storage">
                                <field name="file_size_mb"/>
                                <field name="file_path"/>
                                <field name="company_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SEARCH VIEW                                                  -->
        <!-- ============================================================ -->
        <record id="view_sgt_erp_backup_search" model="ir.ui.view">
            <field name="name">sgt.erp.backup.search</field>
            <field name="model">sgt.erp.backup</field>
            <field name="arch" type="xml">
                <search string="Search Backup Archives">
                    <field name="name"/>
                    <field name="db_name"/>
                    <filter string="Successful" name="filter_success" domain="[('state', '=', 'success')]"/>
                    <filter string="Failed" name="filter_failed" domain="[('state', '=', 'failed')]"/>
                    <separator/>
                    <filter string="Automated (Cron)" name="filter_cron" domain="[('backup_mode', '=', 'cron')]"/>
                    <filter string="Manual" name="filter_manual" domain="[('backup_mode', '=', 'manual')]"/>
                    <group>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Format" name="group_by_type" context="{'group_by': 'backup_type'}"/>
                        <filter string="Trigger Mode" name="group_by_mode" context="{'group_by': 'backup_mode'}"/>
                        <filter string="Created Date" name="group_by_date" context="{'group_by': 'backup_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- ACTION WINDOW                                                -->
        <!-- ============================================================ -->
        <record id="action_sgt_erp_backup" model="ir.actions.act_window">
            <field name="name">Backup Archives</field>
            <field name="res_model">sgt.erp.backup</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No backup archives created yet.
                </p>
                <p>
                    Click <strong>"Full Backup (ZIP)"</strong> or <strong>"Quick Dump"</strong> to create an instant system backup snapshot.
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SERVER ACTIONS (ACTION ⚙ MENU)                                -->
        <!-- ============================================================ -->
        <record id="action_server_backup_schedule" model="ir.actions.server">
            <field name="name">Configure Automated Backup Cron</field>
            <field name="model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = model.action_open_backup_schedule()</field>
        </record>

        <record id="action_server_scan_backups" model="ir.actions.server">
            <field name="name">Scan &amp; Sync Existing Disk Archives</field>
            <field name="model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = model.action_scan_existing_backups()</field>
        </record>

        <record id="action_server_cleanup_old_backups" model="ir.actions.server">
            <field name="name">Cleanup Expired Backup Archives</field>
            <field name="model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = model.action_cleanup_old_backups()</field>
        </record>

        <!-- ============================================================ -->
        <!-- BACKUP CONFIGURATION FORM VIEW & ACTION                      -->
        <!-- ============================================================ -->
        <record id="view_sgt_erp_backup_config_form" model="ir.ui.view">
            <field name="name">sgt.erp.backup.config.form</field>
            <field name="model">sgt.erp.config</field>
            <field name="arch" type="xml">
                <form string="Backup &amp; Disaster Recovery Settings">
                    <header>
                        <button name="action_trigger_backup_zip" string="Create Full Backup (ZIP)" type="object" class="btn btn-primary" icon="fa-database"/>
                        <button name="action_trigger_backup_dump" string="Create Quick Dump" type="object" class="btn btn-secondary" icon="fa-file-text-o"/>
                        <button name="action_open_backup_schedule" string="Configure Cron Schedule" type="object" class="btn btn-outline-info" icon="fa-clock-o"/>
                        <button name="action_open_backup_manager" string="View Backup Archives" type="object" class="btn btn-outline-primary" icon="fa-list"/>
                        <button name="action_scan_existing_backups_config" string="Scan Disk Files" type="object" class="btn btn-outline-dark" icon="fa-search"/>
                        <button name="action_cleanup_old_backups_config" string="Cleanup Old Backups" type="object" class="btn btn-outline-danger" icon="fa-recycle"/>
                    </header>
                    <sheet>
                        <div class="alert alert-info d-flex align-items-center mb-3" role="status">
                            <i class="fa fa-shield fa-2x me-3 text-primary" title="Backup Policy"/>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1">Backup Policy &amp; Disaster Recovery</h5>
                                <span>Configure automated daily backups, retention policies, and monitor system archives.</span>
                            </div>
                        </div>

                        <group>
                            <group string="Automated Backup Policy">
                                <field name="backup_auto_enabled" widget="boolean_toggle" string="Enable Daily Automated Backup"/>
                                <field name="backup_default_type" string="Default Backup Format"/>
                                <field name="backup_retention_days" string="Retention Period (Days)"/>
                            </group>
                            <group string="Current Status &amp; Statistics">
                                <field name="backup_status" widget="badge" 
                                       decoration-success="backup_status == 'ok'" 
                                       decoration-warning="backup_status == 'warning'" 
                                       decoration-danger="backup_status == 'none'"
                                       string="Status"/>
                                <field name="backup_last_date" string="Last Successful Backup" readonly="1"/>
                                <field name="backup_count" string="Total Stored Archives" readonly="1"/>
                                <field name="deployment_docker_container" string="Physical Storage Directory" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sgt_erp_backup_config" model="ir.actions.server">
            <field name="name">Backup Settings</field>
            <field name="model_id" ref="model_sgt_erp_config"/>
            <field name="state">code</field>
            <field name="code">
action = env['sgt.erp.config'].search([('company_id', '=', env.company.id)], limit=1)
if not action:
    action = env['sgt.erp.config'].create({
        'name': f"{env.company.name} ERP Control Center",
        'company_id': env.company.id,
        'customer_name': env.company.name,
        'product_name': 'SGT ERP',
    })
action = {
    'type': 'ir.actions.act_window',
    'name': 'Backup Settings',
    'res_model': 'sgt.erp.config',
    'view_mode': 'form',
    'res_id': action.id,
    'views': [(env.ref('sgt_erp_control_center.view_sgt_erp_backup_config_form').id, 'form')],
    'target': 'current',
}
            </field>
        </record>
    </data>
</odoo>
