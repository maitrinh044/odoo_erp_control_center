<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!-- LIST VIEW                                                    -->
        <!-- ============================================================ -->
        <record id="view_sgt_erp_backup_tree" model="ir.ui.view">
            <field name="name">sgt.erp.backup.list</field>
            <field name="model">sgt.erp.backup</field>
            <field name="arch" type="xml">
                <list string="Danh Sách Bản Sao Lưu" decoration-danger="state == 'failed'" decoration-success="state == 'success'">
                    <header>
                        <button name="action_trigger_backup_now" string="Sao Lưu ZIP" type="object" class="btn btn-sm btn-primary text-nowrap" icon="fa-database" display="always"/>
                        <button name="action_trigger_backup_now" string="Sao Lưu Dump" type="object" class="btn btn-sm btn-outline-secondary text-nowrap" context="{'backup_type': 'dump'}" icon="fa-file-text-o" display="always"/>
                    </header>
                    <field name="name" string="Tên Bản Sao Lưu" class="fw-bold"/>
                    <field name="backup_date" string="Thời Điểm Tạo"/>
                    <field name="backup_type" widget="badge" string="Định Dạng"/>
                    <field name="backup_mode" widget="badge" string="Phương Thức"/>
                    <field name="file_size_mb" string="Dung Lượng (MB)"/>
                    <field name="state" widget="badge" 
                           decoration-success="state == 'success'" 
                           decoration-warning="state == 'running'" 
                           decoration-danger="state == 'failed'" 
                           string="Trạng Thái"/>
                    <field name="company_id" string="Công Ty" optional="hide"/>
                    <button name="action_download_backup" type="object" string="Tải Về" icon="fa-download" class="btn btn-sm btn-outline-primary" invisible="state != 'success'"/>
                    <button name="action_delete_backup" type="object" string="Xóa" icon="fa-trash" class="btn btn-sm btn-link text-danger" confirm="Bạn có chắc muốn xóa vĩnh viễn file sao lưu này khỏi đĩa cứng không?"/>
                </list>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- FORM VIEW                                                    -->
        <!-- ============================================================ -->
        <record id="view_sgt_erp_backup_form" model="ir.ui.view">
            <field name="name">sgt.erp.backup.form</field>
            <field name="model">sgt.erp.backup</field>
            <field name="arch" type="xml">
                <form string="Thông Tin Bản Sao Lưu">
                    <header>
                        <button name="action_trigger_backup_now" string="Khởi Chạy Sao Lưu Ngay" type="object" class="btn btn-success" icon="fa-play" invisible="state == 'success'"/>
                        <button name="action_download_backup" string="Tải File Về Máy" type="object" class="btn btn-primary" icon="fa-download" invisible="state != 'success'"/>
                        <button name="action_delete_backup" string="Xóa File Vĩnh Viễn" type="object" class="btn btn-outline-danger" icon="fa-trash" confirm="Hành động này sẽ xóa file vật lý trên máy chủ. Bạn có chắc chắn không?" invisible="not id"/>
                        <field name="state" widget="statusbar" statusbar_visible="running,success,failed"/>
                    </header>
                    <sheet>
                        <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                            <h4 class="alert-heading fw-bold"><i class="fa fa-exclamation-triangle me-2"/>Tiến trình sao lưu thất bại!</h4>
                            <field name="error_log"/>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Tên File Bản Sao Lưu"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Thông Số Sao Lưu">
                                <field name="backup_date"/>
                                <field name="db_name"/>
                                <field name="backup_type"/>
                                <field name="backup_mode"/>
                            </group>
                            <group string="Lưu Trữ Vật Lý">
                                <field name="file_size_mb"/>
                                <field name="file_path"/>
                                <field name="company_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SEARCH VIEW                                                  -->
        <!-- ============================================================ -->
        <record id="view_sgt_erp_backup_search" model="ir.ui.view">
            <field name="name">sgt.erp.backup.search</field>
            <field name="model">sgt.erp.backup</field>
            <field name="arch" type="xml">
                <search string="Tìm Kiếm Bản Sao Lưu">
                    <field name="name"/>
                    <field name="db_name"/>
                    <filter string="Thành Công" name="filter_success" domain="[('state', '=', 'success')]"/>
                    <filter string="Thất Bại" name="filter_failed" domain="[('state', '=', 'failed')]"/>
                    <separator/>
                    <filter string="Sao Lưu Tự Động (Cron)" name="filter_cron" domain="[('backup_mode', '=', 'cron')]"/>
                    <filter string="Sao Lưu Thủ Công" name="filter_manual" domain="[('backup_mode', '=', 'manual')]"/>
                    <group>
                        <filter string="Trạng Thái" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Định Dạng" name="group_by_type" context="{'group_by': 'backup_type'}"/>
                        <filter string="Phương Thức" name="group_by_mode" context="{'group_by': 'backup_mode'}"/>
                        <filter string="Ngày Tạo" name="group_by_date" context="{'group_by': 'backup_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- ACTION WINDOW                                                -->
        <!-- ============================================================ -->
        <record id="action_sgt_erp_backup" model="ir.actions.act_window">
            <field name="name">Quản Lý Sao Lưu (Backup Manager)</field>
            <field name="res_model">sgt.erp.backup</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Chưa có bản sao lưu nào được tạo.
                </p>
                <p>
                    Bấm vào nút <strong>"Sao Lưu ZIP"</strong> hoặc <strong>"Sao Lưu Dump"</strong> để khởi tạo bản snapshot hệ thống ngay lập tức.
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SERVER ACTIONS (ACTION ⚙ MENU)                                -->
        <!-- ============================================================ -->
        <record id="action_server_backup_schedule" model="ir.actions.server">
            <field name="name">Cấu Hình Lịch Sao Lưu Tự Động (Cron)</field>
            <field name="model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = model.action_open_backup_schedule()</field>
        </record>

        <record id="action_server_scan_backups" model="ir.actions.server">
            <field name="name">Quét &amp; Đồng Bộ File Sẵn Có Trên Đĩa</field>
            <field name="model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = model.action_scan_existing_backups()</field>
        </record>

        <record id="action_server_cleanup_old_backups" model="ir.actions.server">
            <field name="name">Dọn Dẹp Các Bản Sao Lưu Cũ Quá Hạn</field>
            <field name="model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_model_id" ref="model_sgt_erp_backup"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = model.action_cleanup_old_backups()</field>
        </record>

        <!-- ============================================================ -->
        <!-- BACKUP CONFIGURATION FORM VIEW & ACTION                      -->
        <!-- ============================================================ -->
        <record id="view_sgt_erp_backup_config_form" model="ir.ui.view">
            <field name="name">sgt.erp.backup.config.form</field>
            <field name="model">sgt.erp.config</field>
            <field name="arch" type="xml">
                <form string="Cấu Hình Sao Lưu &amp; Khôi Phục Dữ Liệu">
                    <header>
                        <button name="action_trigger_backup_zip" string="Sao Lưu Toàn Diện (ZIP)" type="object" class="btn btn-primary" icon="fa-database"/>
                        <button name="action_trigger_backup_dump" string="Sao Lưu SQL Dump" type="object" class="btn btn-secondary" icon="fa-file-text-o"/>
                        <button name="action_open_backup_schedule" string="Cấu Hình Lịch Trình (Cron)" type="object" class="btn btn-outline-info" icon="fa-clock-o"/>
                        <button name="action_open_backup_manager" string="Xem File Sao Lưu" type="object" class="btn btn-outline-primary" icon="fa-list"/>
                        <button name="action_scan_existing_backups_config" string="Quét File Đĩa" type="object" class="btn btn-outline-dark" icon="fa-search"/>
                        <button name="action_cleanup_old_backups_config" string="Dọn Bản Cũ" type="object" class="btn btn-outline-danger" icon="fa-recycle"/>
                    </header>
                    <sheet>
                        <div class="alert alert-info d-flex align-items-center mb-3" role="status">
                            <i class="fa fa-shield fa-2x me-3 text-primary"/>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1">Thiết Lập Chính Sách Sao Lưu &amp; An Toàn Dữ Liệu (Backup Management)</h5>
                                <span>Tùy chỉnh lịch sao lưu tự động ban đêm, chính sách dọn dẹp lưu trữ và giám sát các bản sao lưu của hệ thống.</span>
                            </div>
                        </div>

                        <group>
                            <group string="Chính Sách Sao Lưu Tự Động">
                                <field name="backup_auto_enabled" widget="boolean_toggle" string="Bật Tự Động Sao Lưu Hàng Ngày"/>
                                <field name="backup_default_type" string="Định Dạng Mặc Định"/>
                                <field name="backup_retention_days" string="Thời Gian Lưu Trữ (Ngày)"/>
                            </group>
                            <group string="Trạng Thái &amp; Thống Kê">
                                <field name="backup_status" widget="badge" 
                                       decoration-success="backup_status == 'ok'" 
                                       decoration-warning="backup_status == 'warning'" 
                                       decoration-danger="backup_status == 'none'"
                                       string="Trạng Thái"/>
                                <field name="backup_last_date" string="Lần Sao Lưu Gần Nhất" readonly="1"/>
                                <field name="backup_count" string="Tổng Số Bản Đang Lưu" readonly="1"/>
                                <field name="deployment_docker_container" string="Thư Mục Lưu Trữ Vật Lý" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sgt_erp_backup_config" model="ir.actions.server">
            <field name="name">Cấu Hình Sao Lưu</field>
            <field name="model_id" ref="model_sgt_erp_config"/>
            <field name="state">code</field>
            <field name="code">
action = env['sgt.erp.config'].search([('company_id', '=', env.company.id)], limit=1)
if not action:
    action = env['sgt.erp.config'].create({
        'name': f"{env.company.name} ERP Control Center",
        'company_id': env.company.id,
        'customer_name': env.company.name,
        'product_name': 'SGT ERP',
    })
action = {
    'type': 'ir.actions.act_window',
    'name': 'Cấu Hình Sao Lưu',
    'res_model': 'sgt.erp.config',
    'view_mode': 'form',
    'res_id': action.id,
    'views': [(env.ref('sgt_erp_control_center.view_sgt_erp_backup_config_form').id, 'form')],
    'target': 'current',
}
            </field>
        </record>
    </data>
</odoo>
