<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sgt_erp_update_tree" model="ir.ui.view">
            <field name="name">sgt.erp.update.list</field>
            <field name="model">sgt.erp.update</field>
            <field name="arch" type="xml">
                <list string="Updates &amp; Releases" decoration-success="state == 'installed'" decoration-info="state == 'available'">
                    <field name="version"/>
                    <field name="name"/>
                    <field name="release_date"/>
                    <field name="state" widget="badge" decoration-success="state == 'installed'" decoration-info="state == 'available'"/>
                    <field name="is_current" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_sgt_erp_update_form" model="ir.ui.view">
            <field name="name">sgt.erp.update.form</field>
            <field name="model">sgt.erp.update</field>
            <field name="arch" type="xml">
                <form string="ERP Release Update">
                    <header>
                        <button name="action_check_updates" string="Check For Addon Updates" type="object" class="btn-primary" icon="fa-refresh"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="E.g. Version 19.0.2.0.0 Release"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="version"/>
                                <field name="release_date"/>
                            </group>
                            <group>
                                <field name="is_current"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="What's New &amp; Changelog" name="changelog">
                                <field name="changelog"/>
                            </page>
                            <page string="Upgrade Notes" name="notes">
                                <field name="upgrade_notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sgt_erp_update" model="ir.actions.act_window">
            <field name="name">Update Manager</field>
            <field name="res_model">sgt.erp.update</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Quản lý các bản cập nhật phiên bản, lịch sử phát hành và ghi chú nâng cấp của SGT ERP.
                </p>
            </field>
        </record>
    </data>
</odoo>
