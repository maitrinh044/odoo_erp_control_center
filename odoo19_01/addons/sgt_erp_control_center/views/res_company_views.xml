<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_company_form_inherit_sgt_erp" model="ir.ui.view">
            <field name="name">res.company.form.inherit.sgt.erp</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="SGT ERP Control Center" name="sgt_erp_settings">
                        <group>
                            <group string="ERP Configuration">
                                <field name="erp_config_id"/>
                                <field name="erp_customer_code"/>
                            </group>
                            <group string="Theme &amp; Package">
                                <field name="erp_theme_id"/>
                                <field name="erp_package_id"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
