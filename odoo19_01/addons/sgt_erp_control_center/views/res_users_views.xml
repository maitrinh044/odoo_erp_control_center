<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View Inherit -->
        <record id="view_users_form_inherit_sgt_erp" model="ir.ui.view">
            <field name="name">res.users.form.inherit.sgt.erp</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="ERP Role &amp; Theme" name="sgt_user_role_theme">
                        <group string="Assigned Role Preset">
                            <group>
                                <field name="role_preset_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <button name="action_apply_role_preset" string="Sync Preset Groups" type="object"
                                        class="btn btn-secondary" icon="fa-refresh"
                                        invisible="not role_preset_id"/>
                            </group>
                        </group>
                        <group string="Personal Theme Customization" groups="sgt_erp_control_center.group_erp_control_center_admin,base.group_system">
                            <field name="use_custom_theme"/>
                            <field name="erp_theme_id" invisible="not use_custom_theme" options="{'no_create': True}"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- List View for SGT ERP Users -->
        <record id="view_sgt_erp_users_tree" model="ir.ui.view">
            <field name="name">sgt.erp.users.tree</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <list string="ERP Users &amp; Role Assignments">
                    <field name="name"/>
                    <field name="login"/>
                    <field name="role_preset_id" widget="badge" decoration-info="role_preset_id"/>
                    <field name="company_id"/>
                    <field name="erp_theme_id" optional="show"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Action to Manage ERP Users -->
        <record id="action_sgt_erp_users" model="ir.actions.act_window">
            <field name="name">Users &amp; Role Assignments</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('share', '=', False)]</field>
            <field name="context">{'search_default_filter_no_share': 1}</field>
            <field name="view_id" ref="view_sgt_erp_users_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Quản lý người dùng nội bộ, gán vai trò mẫu (Role Preset) và tùy biến giao diện cá nhân.
                </p>
            </field>
        </record>
    </data>
</odoo>
